{
  "name": "driver-feedback-bot",
  "version": "1.0.0",
  "description": "Telegram Driver Feedback System with bot, API, and admin panel",
  "main": "index.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "postinstall": "npm ci --prefix admin && npm run build --prefix admin",
    "start": "node index.js",
    "test": "npm run lint:undef && npm run lint:imports && node --test --test-concurrency=1 tests/*.test.js && python -m unittest discover -s leads-bot -p \"test_*.py\"",
    "lint:filesize": "node scripts/checkFileSize.js",
    "lint:filesize:list": "node scripts/checkFileSize.js --list",
    "lint:undef": "eslint . --max-warnings 0",
    "lint:imports": "node scripts/checkImports.js",
    "lint:imports:list": "node scripts/checkImports.js --list",
    "dev": "node index.js",
    "seed-admin": "node scripts/seed-admin.js",
    "init-db": "node scripts/init-db.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "migrate:new": "node scripts/create-migration.js",
    "build:schema": "node scripts/build-schema.js",
    "build:schema:check": "node scripts/build-schema.js --check",
    "db:docs": "node scripts/generate-db-docs.js",
    "db:docs:from-schema": "node scripts/generate-db-docs.js --from-schema",
    "upload-safety-music": "node scripts/upload-safety-music.js",
    "backfill-driver-people": "node scripts/backfill-driver-people.js",
    "operations:preview": "node scripts/operations-preview.js",
    "discover-bitrix-fields": "node scripts/discover-bitrix-lead-fields.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.4.4",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pdf-parse": "^2.4.5",
    "pg": "^8.11.3",
    "sharp": "^0.35.5",
    "telegraf": "^4.15.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0"
  }
}
