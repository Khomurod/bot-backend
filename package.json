{
  "name": "driver-feedback-bot",
  "version": "1.0.0",
  "description": "Telegram Driver Feedback System with bot, API, and admin panel",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm ci --prefix admin && npm run build --prefix admin",
    "start": "node --max-old-space-size=256 index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js && python -m unittest discover -s leads-bot -p \"test_*.py\"",
    "lint:filesize": "node scripts/checkFileSize.js",
    "lint:filesize:list": "node scripts/checkFileSize.js --list",
    "bot": "node bot/bot.js",
    "server": "node server/api.js",
    "dev": "node index.js",
    "seed-admin": "node scripts/seed-admin.js",
    "init-db": "node scripts/init-db.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "migrate:new": "node scripts/create-migration.js",
    "build:schema": "node scripts/build-schema.js",
    "build:schema:check": "node scripts/build-schema.js --check",
    "db:docs": "node scripts/generate-db-docs.js",
    "db:docs:from-schema": "node scripts/generate-db-docs.js --from-schema",
    "upload-safety-music": "node scripts/upload-safety-music.js",
    "backfill-driver-profiles": "node scripts/backfill-driver-profiles.js",
    "migrate-media": "node scripts/migrate-media.js",
    "migrate-multi-media": "node scripts/migrate-multi-media.js",
    "discover-bitrix-fields": "node scripts/discover-bitrix-lead-fields.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.4.4",
    "multer": "^2.1.1",
    "nodemailer": "^6.10.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.11.3",
    "sharp": "^0.34.4",
    "telegraf": "^4.15.3",
    "tesseract.js": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
