# A dependency tree is never repository content. NO TRAILING SLASH on these
# three: a trailing slash matches a DIRECTORY only, and that is precisely how
# `node_modules` and `admin/node_modules` were once committed as symlinks to
# absolute paths on one developer's machine. tests/repoHygiene.test.js guards it.
node_modules
dist/
admin/node_modules
admin/dist/
admin/build/
fleet/node_modules
fleet/dist/
fleet/build/
__pycache__/
*.pyc
*.pyo
.env
.env.*
!.env.example

# Runtime log snapshots. These were committed once by accident; nothing in the
# application reads them back.
*.log

# On-demand database reference generated by `npm run db:docs`. Committed copies
# drifted from the real schema; generate one when you need it. The authoritative
# schema is database/baseline/*.sql -> database/schema.sql + database/migrations/.
docs/database/schema-current.md
docs/database/schema-current.sql
docs/database/relationships.md

# Local scratch / one-off AI-agent working directories. Keep them out of git —
# they are working files, not repository content.
scratch/
brain/
reports/
.cursor/
